        "partitions": [
          {
            "name": "clients",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(Text.TrimEnd(DossierDonnees, \"\\\") & \"\\clients.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Entetes, {{\"id_client\", type text}, {\"genre\", type text}, {\"senior\", type text}, {\"en_couple\", type text}, {\"personnes_a_charge\", type text}, {\"anciennete_mois\", Int64.Type}, {\"tranche_anciennete\", type text}, {\"tranche_ordre\", Int64.Type}, {\"contrat\", type text}, {\"internet\", type text}, {\"moyen_paiement\", type text}, {\"facture_dematerialisee\", type text}, {\"nb_services\", Int64.Type}, {\"support_technique\", type text}, {\"securite_en_ligne\", type text}, {\"facture_mensuelle\", type number}, {\"total_facture\", type number}, {\"valeur_annuelle\", type number}, {\"churn\", Int64.Type}, {\"churn_reel\", type text}, {\"probabilite_churn\", type number}, {\"segment_risque\", type text}, {\"cible_campagne\", type text}, {\"gain_attendu\", type number}, {\"motif_1\", type text}, {\"motif_2\", type text}}, \"en-US\")",
                "in",
                "    Types"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Nb clients",
            "expression": "COUNTROWS ( clients )",
            "formatString": "#,0",
            "lineageTag": "b65798d5-1e2c-41ab-890a-3e00d712c8eb"
          },
          {
            "name": "Nb départs",
            "expression": "SUM ( clients[churn] )",
            "formatString": "#,0",
            "lineageTag": "4699decb-4879-48af-875e-dadd87a3ee9e"
          },
          {
            "name": "Taux de churn",
            "expression": "DIVIDE ( [Nb départs], [Nb clients] )",
            "formatString": "0.0 %",
            "lineageTag": "e73aa0e7-830b-4f36-b3d3-0186d92fa079"
          },
          {
            "name": "Revenu mensuel",
            "expression": "SUM ( clients[facture_mensuelle] )",
            "formatString": "#,0 $",
            "lineageTag": "a58928d3-65fa-40ff-8bcd-aed910f6b03b"
          },
          {
            "name": "Revenu mensuel perdu",
            "expression": "CALCULATE ( SUM ( clients[facture_mensuelle] ), clients[churn] = 1 )",
            "formatString": "#,0 $",
            "lineageTag": "3da31b2d-e4a6-4d6e-9032-e4513f1b87db"
          },
          {
            "name": "Part du revenu perdu",
            "expression": "DIVIDE ( [Revenu mensuel perdu], [Revenu mensuel] )",
            "formatString": "0.0 %",
            "lineageTag": "26a501a8-e80e-4a11-a21d-5d4bc2040ae5"
          },
          {
            "name": "Probabilité moyenne",
            "expression": "AVERAGE ( clients[probabilite_churn] )",
            "formatString": "0.0 %",
            "lineageTag": "fc956e97-dce5-40a3-adf4-0aa6b89aaef1"
          },
          {
            "name": "Clients à risque élevé",
            "expression": "CALCULATE ( [Nb clients], clients[segment_risque] = \"Élevé\" )",
            "formatString": "#,0",
            "lineageTag": "d85010bd-4ab9-4bdd-a11d-46fa0b5cf1c8"
          },
          {
            "name": "Clients ciblés",
            "expression": "CALCULATE ( [Nb clients], clients[cible_campagne] = \"Oui\" )",
            "formatString": "#,0",
            "lineageTag": "d2111ee9-72b1-4a1b-9e64-c4bf22e82a69"
          },
          {
            "name": "Revenu mensuel à risque",
            "expression": "SUMX ( clients, clients[facture_mensuelle] * clients[probabilite_churn] )",
            "formatString": "#,0 $",
            "lineageTag": "fd143abf-30a5-4ea2-b8f1-bb1c602fb7f9"
          },
          {
            "name": "Gain attendu de la campagne",
            "expression": "CALCULATE ( SUM ( clients[gain_attendu] ), clients[cible_campagne] = \"Oui\" )",
            "formatString": "#,0 $",
            "lineageTag": "336e1468-aa46-4427-aad2-883af7bbb98c"
          }
        ]
      },
